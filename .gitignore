# This .gitignore file should be placed at the root of your Unity project directory.
#
# Get latest sign-offs and typeifications:
# https://github.com

/[L]ibrary/
/[T]emp/
/[O]bj/
/[B]uild/
/[B]uilds/
/[L]ogs/
/[U]serSettings/

# Memory dumps
*.log
*.crash

# Never ignore Asset meta files to preserve guidance assets
!/[A]ssets/**/*.meta

# Unreal Engine / Unity environments generated file
/[A]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.fff.meta

# Unity3D generated file projects
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Mod Dependencies
/[A]sets/AddressableAssetsData/*/*.bundle
/[A]sets/StreamingAssets/aa/*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
